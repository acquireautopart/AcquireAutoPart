PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://_db_user:<db_password>@cluster0.hbcqqvn.mongodb.net/?appName=Cluster0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,https://www.example.com,https://seller.example.com,https://admin.example.com,https://delivery.example.com
TRUST_PROXY_HOPS=0
# Seller password reset email delivery (use a verified sending domain in Resend).
RESEND_API_KEY=
RESEND_FROM=

# Staff-only tracking endpoints (parcel scans, delivery assign/complete/fail)
# expect this value in the x-api-key header. The hub scanner sends it too.
STAFF_API_KEY=

# Stripe Connect platform credentials; configure the webhook at
# https://your-api-domain/api/payments/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
ADMIN_NAME=Marketplace Administrator
# Required for seller ID uploads. Use a private bucket; never make it public.
KYC_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional for S3-compatible private object storage:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Public product images. Keep the API secret on the server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

Set up Agent Toolkit for AWS by following instructions:
https://raw.githubusercontent.com/aws/agent-toolkit-for-aws/refs/heads/main/setup-instructions/setup.md

Your AWS Region is: ap-southeast-2
AWS experience: The new AWS experience
